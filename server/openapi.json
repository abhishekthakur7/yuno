{
  "components": {
    "schemas": {
      "CanonicalTopicRelationResponse": {
        "description": "One `TopicRelation` row nested in\n`CanonicalVersionDetailResponse.relations`.",
        "properties": {
          "from_stable_id": {
            "title": "From Stable Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "relation_type": {
            "title": "Relation Type",
            "type": "string"
          },
          "to_stable_id": {
            "title": "To Stable Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "from_stable_id",
          "to_stable_id",
          "relation_type",
          "rationale"
        ],
        "title": "CanonicalTopicRelationResponse",
        "type": "object"
      },
      "CanonicalTopicResponse": {
        "description": "One `Topic` row nested in `CanonicalVersionDetailResponse.topics`.",
        "properties": {
          "checkpoint_end": {
            "title": "Checkpoint End",
            "type": "integer"
          },
          "checkpoint_start": {
            "title": "Checkpoint Start",
            "type": "integer"
          },
          "level_tag": {
            "title": "Level Tag",
            "type": "string"
          },
          "recommended_layer": {
            "title": "Recommended Layer",
            "type": "string"
          },
          "scope_tags": {
            "items": {
              "type": "string"
            },
            "title": "Scope Tags",
            "type": "array"
          },
          "stable_id": {
            "title": "Stable Id",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "target_capability": {
            "title": "Target Capability",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "stable_id",
          "title",
          "subject",
          "scope_tags",
          "level_tag",
          "target_capability",
          "recommended_layer",
          "checkpoint_start",
          "checkpoint_end"
        ],
        "title": "CanonicalTopicResponse",
        "type": "object"
      },
      "CanonicalVersionDetailResponse": {
        "description": "`GET /api/v1/canonical/versions/{id}` response body: the version\nplus its published topics and relations (spec \u00a75.2). Nests, rather\nthan requiring separate topic/relation calls, since a caller reading\none canonical graph version wants its whole shape in one round trip\nand both are approval-gated identically (`ports.py`'s\n`get_published_topics`/`get_published_relations`).",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "manifest_version": {
            "title": "Manifest Version",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "relations": {
            "items": {
              "$ref": "#/components/schemas/CanonicalTopicRelationResponse"
            },
            "title": "Relations",
            "type": "array"
          },
          "supersedes_version_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Version Id"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/CanonicalTopicResponse"
            },
            "title": "Topics",
            "type": "array"
          },
          "version_label": {
            "title": "Version Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version_label",
          "manifest_version",
          "created_at",
          "published_at",
          "supersedes_version_id",
          "topics",
          "relations"
        ],
        "title": "CanonicalVersionDetailResponse",
        "type": "object"
      },
      "CanonicalVersionSummaryResponse": {
        "description": "One entry of `GET /api/v1/canonical/versions` (spec \u00a75.2). Mirrors\n`modules.canonical.domain.CanonicalGraphVersion`, minus the internal\n`creator_owner_id` -- see `yuno.api.routes.canonical` for why callers\nnever see who ran the offline publisher.",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "manifest_version": {
            "title": "Manifest Version",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "supersedes_version_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Version Id"
          },
          "version_label": {
            "title": "Version Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version_label",
          "manifest_version",
          "created_at",
          "published_at",
          "supersedes_version_id"
        ],
        "title": "CanonicalVersionSummaryResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The spec \u00a75.1 error envelope: every `YunoError`, request validation\nfailure, and unhandled exception renders through this shape (see\n`yuno.api.errors.register_exception_handlers`).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "current_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current State"
          },
          "field_errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Errors"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "recovery_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Action"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "correlation_id",
          "retryable"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "description": "One entry of `ErrorResponse.field_errors`. The domain layer leaves\n`YunoError.field_errors` generic (`Sequence[Mapping[str, Any]]`); a\ncaller must supply mappings with exactly these two keys.",
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "`GET /api/v1/health` response body.",
        "properties": {
          "schema_revision": {
            "title": "Schema Revision",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "schema_revision"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Yuno",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/canonical/versions": {
      "get": {
        "description": "List every approved canonical graph version.",
        "operationId": "list_canonical_versions_api_v1_canonical_versions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CanonicalVersionSummaryResponse"
                  },
                  "title": "Response List Canonical Versions Api V1 Canonical Versions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "List Canonical Versions",
        "tags": [
          "canonical"
        ]
      }
    },
    "/api/v1/canonical/versions/{version_id}": {
      "get": {
        "description": "Fetch one approved canonical graph version with its published topics\nand relations. Raises `404` whether the version doesn't exist or just\nisn't approved (module docstring).",
        "operationId": "get_canonical_version_api_v1_canonical_versions__version_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "title": "Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanonicalVersionDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Get Canonical Version",
        "tags": [
          "canonical"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Liveness/readiness probe. The server only starts once\n`api.app.create_app` has confirmed a single Alembic head, so a `200`\nhere implies the schema is at a known revision.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
