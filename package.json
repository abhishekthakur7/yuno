{
  "name": "yuno-learning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "dev:api": "uv run --directory server alembic upgrade head && uv run --directory server uvicorn yuno.main:app --reload",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:export": "uv run --directory server python scripts/export_openapi.py",
    "openapi:generate": "openapi-typescript server/openapi.json -o src/shared/api/schema.d.ts",
    "openapi:check": "uv run --directory server python scripts/export_openapi.py --check && node scripts/check-openapi-drift.mjs",
    "review:check": "node scripts/check-review-records.mjs",
    "perf": "node scripts/perf/run.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.24",
    "lucide-react": "0.468.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.10.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
